# Copy to .env.local and fill in. Both values are safe to commit -- the anon key
# is public by design and only RLS protects your data. Never put the service_role
# key in a NEXT_PUBLIC_ var or in this file.
#
#   cp .env.example .env.local
#
# Local stack (npm run db:start): run `npx supabase status` and copy the "API URL"
# and "anon key" rows. The local stack also has a service_role key, but this app
# never needs it.
#
# Hosted project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
